# Complete local/reference configuration for ZASI J.A.R.V.I.S.
# The API key below is a valid local-only example credential for loopback use.
ZASI_PROFILE=local
ZASI_HOST=127.0.0.1
ZASI_PORT=8080
ZASI_ALLOW_PUBLIC_BIND=no
ZASI_API_KEY=7eb9fd112e67c59c56d960f2636c8dca54a8351f9d5667ee93cb0588fcb013d
ZASI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ZASI_CORS_ORIGIN=http://localhost:5173
ZASI_DATABASE_PATH=./data/zasi_control_plane.db
ZASI_ARTIFACT_DIRECTORY=./data/artifacts
ZASI_MAX_BODY=1048576
ZASI_AUTH_RATE_LIMIT=10
ZASI_AUTH_RATE_WINDOW=60
ZASI_REQUEST_RATE_LIMIT=120
ZASI_REQUEST_RATE_WINDOW=60
ZASI_EVENT_RETENTION=10000
ZASI_DATABASE_BACKEND=sqlite
ZASI_SECRET_PROVIDER=environment
ZASI_BACKUP_POLICY=local
ZASI_ENABLE_EXTERNAL_EGRESS=no
ZASI_ENABLE_RESEARCH_EXECUTION=no
ZASI_ENABLE_PHYSICAL_ACTUATION=no
ZASI_ENABLE_LEGACY_COMPAT=no
ZASI_ENABLE_EXTERNAL_MODEL_ROUTING=no
