{
  "name": "production-main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH",
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {"context": "Test (Python 3.11)"},
          {"context": "Test (Python 3.12)"},
          {"context": "Build Distribution"},
          {"context": "Docker Build Check"},
          {"context": "Dependency Review"},
          {"context": "Python Syntax & React TypeScript Validation"},
          {"context": "Analyze (actions)"},
          {"context": "Analyze (javascript-typescript)"},
          {"context": "Analyze (python)"},
          {"context": "Build and Security Scan Docker Image"},
          {"context": "Build security evidence"},
          {"context": "Clean PostgreSQL backup restore rehearsal"},
          {"context": "Local two-replica canary and failure rehearsal"},
          {"context": "Base to candidate to immutable rollback"},
          {"context": "Validate production GO evidence contract"}
        ]
      }
    }
  ]
}
