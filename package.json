{
  "name": "zasi-cockpit",
  "version": "32.0.0",
  "description": "ZASI J.A.R.V.I.S. Omniversal Superintelligence Web Cockpit — React 18 + React Router v6",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite web/",
    "build": "vite build web/",
    "preview": "vite preview",
    "electron": "electron electron/main.js",
    "electron-build": "electron-builder --linux --mac --win",
    "test": "node tests/test_components.js"
  },
  "devDependencies": {
    "vite": "^6.4.3",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.zasi.cockpit",
    "productName": "ZASI J.A.R.V.I.S.",
    "directories": { "output": "dist-electron" },
    "files": ["electron/**/*", "web/**/*", "backend/**/*", "src/**/*"],
    "linux": { "target": "AppImage" },
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" }
  },
  "keywords": ["ai","superintelligence","jarvis","zasi","react","react-router"],
  "license": "MIT"
}
